; This is a CTP file
; DIS test input
; SHMS detects the electron
; HMS detects the proton
; Both arms enabled

begin parm experiment
  ngen = 2000                  ; POS: number of successes; NEG: number of tries
  EXPER%charge = 1.0            ; total charge (mC)

  doing_phsp = 0
  doing_kaon = 0
  doing_pion = 0
  doing_delta = 0
  doing_rho  = 0
  doing_semi = 0
  doing_dis  = 1

  doing_decay = 0
  ctau = 0.0

  dis_datfile = /w/hallc-scshelf2102/c-lad/haocen/simc/simc_dis_gen/dis/test_band_tagged_full_PRC_E10.2GeV_recp.dat
end parm experiment

begin parm kinematics_main
  Ebeam = 11000.0               ; MeV
  dEbeam = 0.05                 ; beam energy variation (%)

  electron_arm = 5              ; 1=hms,2=sos,3=hrsr,4=hrsl,5=shms
  hadron_arm   = 1              ; HMS detects proton

  spec%e%P = 3710.0             ; SHMS central momentum for electron (MeV/c)
  spec%e%theta = 15.581         ; SHMS central angle for electron (deg)

  spec%p%P = 3000.0             ; HMS central momentum for proton (MeV/c)
  spec%p%theta = 20.0           ; HMS central angle for proton (deg)
end parm kinematics_main

begin parm target
  targ%A = 1.0
  targ%Z = 1.0
  targ%mass_amu = 1.007276
  targ%mrec_amu = 0.0
  targ%rho = 0.0723
  targ%thick = 286.89
  targ%angle = 0.0
  targ%abundancy = 0.0
  targ%can = 2
end parm target

begin parm debug
  debug(1) = 0
  debug(2) = 0
  debug(3) = 0
  debug(4) = 0
  debug(5) = 0
end parm debug

begin parm e_arm_accept
  SPedge%e%delta%min = -20.0
  SPedge%e%delta%max =  20.0
  SPedge%e%yptar%min = -40.0
  SPedge%e%yptar%max =  40.0
  SPedge%e%xptar%min = -90.0
  SPedge%e%xptar%max =  90.0
end parm e_arm_accept

begin parm p_arm_accept
  SPedge%p%delta%min = -15.0
  SPedge%p%delta%max =  15.0
  SPedge%p%yptar%min = -40.0
  SPedge%p%yptar%max =  40.0
  SPedge%p%xptar%min = -90.0
  SPedge%p%xptar%max =  90.0
end parm p_arm_accept

begin parm beamandtargetinfo
  gen%xwid = 0.008868           ; beam width - one sigma (cm)
  gen%ywid = 0.004235           ; beam width - one sigma (cm)
  targ%fr_pattern = 1.0         ; raster pattern: 1=square, 2=circular
  targ%fr1 = 0.1
  targ%fr2 = 0.1
  targ%xoffset = 0.200
  targ%yoffset = 0.0
  targ%zoffset = 0.315
end parm beamandtargetinfo

begin parm spect_offset
  spec%e%offset%x = 0.0
  spec%e%offset%y = 0.0
  spec%e%offset%z = 0.0
  spec%e%offset%xptar = 0.0
  spec%e%offset%yptar = 0.0

  spec%p%offset%x = 0.0
  spec%p%offset%y = 0.0
  spec%p%offset%z = 0.0
  spec%p%offset%xptar = 0.0
  spec%p%offset%yptar = 0.0
end parm spect_offset

begin parm simulate
  hard_cuts = 0
  using_rad = 0
  use_expon = 0
  one_tail = 0
  intcor_mode = 1

  spect_mode = 0                ; both E-arm and P-arm Monte Carlo run

  cuts%Em%min = 0.0
  cuts%Em%max = 0.0

  using_Eloss = 1
  correct_Eloss = 1
  correct_raster = 1
  mc_smear = 1

  deForest_flag = 0
  rad_flag = 0
  extrad_flag = 2
  lambda(1) = 0.0
  lambda(2) = 0.0
  lambda(3) = 0.0

  Nntu = 1
  using_Coulomb = 1
  dE_edge_test = 0.0
  use_offshell_rad = 0
  Egamma_gen_max = 0.0
end parm simulate
